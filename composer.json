{
  "name": "sierraglobalcompany/erp-meli-2",
  "description": "ERP Meli 2.0 - greenfield modular monolith",
  "license": "proprietary",
  "type": "project",
  "require": {
    "php": "^8.5",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-session": "*",
    "ext-sodium": "*",
    "slim/slim": "^4.15.3",
    "slim/psr7": "^1.8"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.4",
    "phpstan/phpstan": "^2.1"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "lint": "find app public bin tests -name '*.php' -print0 | xargs -0 -n1 php -l",
    "test": "phpunit",
    "analyse": "phpstan analyse --no-progress",
    "qa": [
      "@lint",
      "@analyse",
      "@test"
    ]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": false
  }
}
